# Swift Package Manager
.build/
.swiftpm/

# App bundle and backups written by Scripts/build-app.sh
build/

# Fuzz and stress build output (their READMEs: out/ can be deleted at any time)
Tests/Fuzz/out/
Tests/Stress/out/

# The Xcode project of the UI tests, generated from UITests/project.yml by UITests/run.sh
UITests/AFileManagerUITests.xcodeproj/

# Temporary working files
scratchpad/

# Build folders of the quality gates (Scripts/check.sh)
.build-tools/
.build-native/
.build-codeql/
.build-address/
.build-thread/
.build-undefined/

# macOS
.DS_Store

# Claude Code: agent worktrees (each a copy of the whole project) and local settings
.claude/

# Coverage counts a test process writes where no LLVM_PROFILE_FILE is set.
*.profraw
